# macOS
.DS_Store

# Runtime data - never committed (backups contain personal data, logs may too)
Part2_Development/app/storage/backups/*.sql
Part2_Development/app/storage/logs/*.log

# Apache runtime files and the private TLS key / certificate
Part2_Development/deploy/apache/run/
Part2_Development/deploy/apache/ssl/

# Python cache
__pycache__/

# Python virtual environment for the browser test
Part2_Development/tests/.venv/

# Cloud database passwords written by deploy/railway/init_remote_db.sh
Part2_Development/deploy/railway/app.env

# Node dependencies and Playwright output for the e2e tests
node_modules/
Part2_Development/tests/e2e/test-results/
Part2_Development/tests/e2e/playwright-report/

# Word lock files and raw Playwright artifacts
~$*
Part2_Development/tests/e2e/results/raw/
